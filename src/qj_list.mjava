public String list_pagesOf(HashMap m) {
    int total = 0;
    try {
        total = Integer.parseInt(list_s(m.get("total")));
    } catch (Throwable t) {
    }
    if (total <= 0) return "";
    return " / 共 " + total + " 页";
}

public void list_historyRows(int containerId, ArrayList items) {
    LinearLayout host = (LinearLayout) activity.findViewById(containerId);
    if (host == null) return;
    host.removeAllViews();
    list_historyRowsView(host, items);
}

public void list_historyRowsView(LinearLayout host, ArrayList items) {
    if (host == null) return;
    for (int k = 0; k < items.size(); k++) {
        HashMap m = (HashMap) items.get(k);
        LinearLayout row = new LinearLayout(activity);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setPadding(ui_dp(16), ui_dp(16), ui_dp(16), ui_dp(16));

        ImageView cover = new ImageView(activity);
        cover.setScaleType(ImageView.ScaleType.CENTER_CROP);
        GradientDrawable bg = new GradientDrawable();
        bg.setColor(ui_c("surfaceContainer"));
        bg.setCornerRadius(ui_dp(6));
        cover.setBackground(bg);
        row.addView(cover, new LinearLayout.LayoutParams(ui_dp(56), ui_dp(76)));
        String cov = (String) m.get("cover");
        if (cov != null && cov.length() > 0) i.us(cover, "src", cov);

        LinearLayout col = new LinearLayout(activity);
        col.setOrientation(LinearLayout.VERTICAL);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, -2, 1);
        lp.leftMargin = ui_dp(12);
        row.addView(col, lp);

        TextView title = new TextView(activity);
        title.setText((String) m.get("title"));
        title.setTextSize(16);
        title.setTextColor(ui_c("onSurface"));
        title.setTypeface(null, Typeface.BOLD);
        title.setMaxLines(1);
        title.setEllipsize(TextUtils.TruncateAt.END);
        col.addView(title);

        int p = 1;
        int total = 0;
        try { p = Integer.parseInt(list_s(m.get("page"))); } catch (Throwable t) { }
        try { total = Integer.parseInt(list_s(m.get("total"))); } catch (Throwable t) { }
        boolean done = total > 0 && p >= total;

        TextView sub = new TextView(activity);
        sub.setText(done ? "已读完" : ("读到第 " + p + " 页" + list_pagesOf(m)));
        sub.setTextSize(13);
        sub.setTextColor(done ? ui_c("primary") : ui_c("onSurfaceVariant"));
        LinearLayout.LayoutParams slp = new LinearLayout.LayoutParams(-2, -2);
        slp.topMargin = ui_dp(2);
        col.addView(sub, slp);

        if (total <= 0) total = 100;
        if (p < 0) p = 0;
        if (p > total) p = total;
        LinearLayout bar = new LinearLayout(activity);
        bar.setOrientation(LinearLayout.HORIZONTAL);
        View filled = new View(activity);
        filled.setBackgroundColor(ui_c("primary"));
        View rest = new View(activity);
        rest.setBackgroundColor(ui_c("divider"));
        bar.addView(filled, new LinearLayout.LayoutParams(0, -1, (float) p));
        bar.addView(rest, new LinearLayout.LayoutParams(0, -1, (float) (total - p + 1)));
        LinearLayout.LayoutParams blp = new LinearLayout.LayoutParams(-1, ui_dp(4));
        blp.topMargin = ui_dp(8);
        col.addView(bar, blp);

        row.setTag(m);
        row.setOnClickListener(new View.OnClickListener() {
            public void onClick(View v) {
                HashMap item = (HashMap) v.getTag();
                try {
                    i.sss("qj.item", new JSONObject(item).toString());
                    i.sss("qj.page", list_s(item.get("page")));
                    i.uigo("reader.iyu");
                } catch (Throwable t) {
                    i.syso("LIST history open fail " + t);
                }
            }
        });
        ui_rippleView(row);
        host.addView(row);
        if (k < items.size() - 1) host.addView(list_divider());
    }
    i.syso("LIST history n=" + items.size());
}


