public void list_books(int containerId, ArrayList items) {
    list_clear(containerId);
    list_rows(containerId, items);
}

public void list_clear(int containerId) {
    LinearLayout host = (LinearLayout) activity.findViewById(containerId);
    if (host != null) host.removeAllViews();
}

public void list_rows(int containerId, ArrayList items) {
    LinearLayout host = (LinearLayout) activity.findViewById(containerId);
    if (host == null) return;
    for (int k = 0; k < items.size(); k++) {
        host.addView(list_row((HashMap) items.get(k)));
        if (k < items.size() - 1) host.addView(list_divider());
    }
    i.syso("LIST rows n=" + items.size());
}

public void list_header(int containerId, String text) {
    LinearLayout host = (LinearLayout) activity.findViewById(containerId);
    if (host == null) return;
    TextView t = new TextView(activity);
    t.setText(text);
    t.setTextSize(20);
    t.setTextColor(ui_c("onSurface"));
    t.setTypeface(Typeface.create("serif", Typeface.BOLD));
    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-1, -2);
    lp.leftMargin = ui_dp(16);
    lp.rightMargin = ui_dp(16);
    lp.topMargin = ui_dp(24);
    lp.bottomMargin = ui_dp(8);
    t.setLayoutParams(lp);
    host.addView(t);
}

public void list_cards(int containerId, ArrayList items) {
    LinearLayout host = (LinearLayout) activity.findViewById(containerId);
    if (host == null) return;
    HorizontalScrollView hs = new HorizontalScrollView(activity);
    hs.setHorizontalScrollBarEnabled(false);
    LinearLayout row = new LinearLayout(activity);
    row.setOrientation(LinearLayout.HORIZONTAL);
    row.setPadding(ui_dp(16), 0, ui_dp(4), 0);
    hs.addView(row);
    host.addView(hs);
    for (int k = 0; k < items.size(); k++) row.addView(list_card((HashMap) items.get(k)));
    i.syso("LIST cards n=" + items.size());
}

public View list_card(HashMap m) {
    LinearLayout card = new LinearLayout(activity);
    card.setOrientation(LinearLayout.VERTICAL);
    LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(ui_dp(132), -2);
    clp.rightMargin = ui_dp(12);
    card.setLayoutParams(clp);

    ImageView cover = new ImageView(activity);
    cover.setScaleType(ImageView.ScaleType.CENTER_CROP);
    GradientDrawable bg = new GradientDrawable();
    bg.setColor(ui_c("surfaceContainer"));
    bg.setCornerRadius(ui_dp(8));
    cover.setBackground(bg);
    card.addView(cover, new LinearLayout.LayoutParams(ui_dp(132), ui_dp(176)));
    String cov = (String) m.get("cover");
    if (cov != null && cov.length() > 0) i.us(cover, "src", cov);

    TextView title = new TextView(activity);
    title.setText((String) m.get("title"));
    title.setTextSize(16);
    title.setTextColor(ui_c("onSurface"));
    title.setTypeface(null, Typeface.BOLD);
    title.setMaxLines(2);
    title.setEllipsize(TextUtils.TruncateAt.END);
    LinearLayout.LayoutParams tlp = new LinearLayout.LayoutParams(-1, -2);
    tlp.topMargin = ui_dp(8);
    card.addView(title, tlp);

    TextView sub = new TextView(activity);
    sub.setText((String) m.get("author"));
    sub.setTextSize(13);
    sub.setTextColor(ui_c("onSurfaceVariant"));
    sub.setMaxLines(1);
    sub.setEllipsize(TextUtils.TruncateAt.END);
    LinearLayout.LayoutParams slp = new LinearLayout.LayoutParams(-1, -2);
    slp.topMargin = ui_dp(2);
    card.addView(sub, slp);

    card.setTag(m);
    card.setOnClickListener(new View.OnClickListener() {
        public void onClick(View v) {
            HashMap item = (HashMap) v.getTag();
            try {
                i.sss("qj.item", new JSONObject(item).toString());
                i.uigo("detail.iyu");
            } catch (Throwable t) {
                i.syso("LIST open fail " + t);
            }
        }
    });
    ui_rippleView(card);
    return card;
}

