// 青简 · 阅读器。方法统一 reader_ 前缀；iyu 入口：boot / prev / next / font / toc / back。

import java.util.ArrayList;
import java.util.HashMap;
import android.content.DialogInterface;
import android.view.View;
import android.webkit.WebView;
import android.widget.ImageView;
import android.widget.TextView;
import com.google.android.material.dialog.MaterialAlertDialogBuilder;
import org.json.JSONObject;
import org.json.JSONArray;

public void boot() {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store");
    if (i.sss("qj.font") == null) i.sss("qj.font", "18");
    if (i.sss("qj.page") == null) i.sss("qj.page", "1");
    reader_chrome();
    reader_load();
}

public void reader_chrome() {
    View root = activity.findViewById(1);
    if (root != null) root.setBackgroundColor(ui_c("surface"));
    View top = activity.findViewById(2);
    if (top != null) top.setBackgroundColor(ui_c("surface"));
    View bottom = activity.findViewById(12);
    if (bottom != null) bottom.setBackgroundColor(ui_c("surfaceContainer"));
    TextView t = (TextView) activity.findViewById(4);
    if (t != null) t.setTextColor(ui_c("onSurface"));
    ImageView back = (ImageView) activity.findViewById(3);
    if (back != null) {
        back.setImageBitmap(ui_iconSize("back", 44, (float) 1.3));
        back.setColorFilter(ui_c("primary"));
    }
    TextView toc = (TextView) activity.findViewById(5);
    if (toc != null) toc.setTextColor(ui_c("primary"));
    TextView prev = (TextView) activity.findViewById(14);
    if (prev != null) prev.setTextColor(ui_c("primary"));
    TextView next = (TextView) activity.findViewById(16);
    if (next != null) next.setTextColor(ui_c("primary"));
    TextView pg = (TextView) activity.findViewById(15);
    if (pg != null) pg.setTextColor(ui_c("onSurfaceVariant"));
    reader_tintFonts();
}

public void reader_tintFonts() {
    String f = String.valueOf(i.sss("qj.font"));
    int[] ids = {18, 19, 20};
    String[] sp = {"16", "18", "21"};
    for (int k = 0; k < 3; k++) {
        TextView tv = (TextView) activity.findViewById(ids[k]);
        if (tv == null) continue;
        boolean on = sp[k].equals(f);
        tv.setTextColor(on ? ui_c("primary") : ui_c("onSurfaceVariant"));
        tv.setTypeface(null, on ? android.graphics.Typeface.BOLD : android.graphics.Typeface.NORMAL);
    }
}

public void reader_load() {
    new Thread(new Runnable() {
        public void run() {
            String itemJson = (String) i.sss("qj.item");
            if (itemJson == null) {
                i.syso("READER no item");
                return;
            }
            HashMap res = new HashMap();
            try {
                JSONObject it = new JSONObject(itemJson);
                res = core_read(it.optString("surl"), 18);
            } catch (Throwable t) {
                i.syso("READER item fail " + t);
            }

            JSONArray arr = (JSONArray) res.get("contents");
            ArrayList list = new ArrayList();
            if (arr != null) {
                for (int k = 0; k < arr.length(); k++) list.add(arr.optString(k));
            }
            i.sss("qj.read.contents", list);
            i.sss("qj.read.catalogs", res.get("catalogs"));
            i.sss("qj.read.total", res.get("pageAll") == null ? "" + list.size() : (String) res.get("pageAll"));

            int start = 0;
            try {
                start = Integer.parseInt(String.valueOf(i.sss("qj.page"))) - 1;
            } catch (Throwable t) {
                start = 0;
            }
            if (start < 0) start = 0;
            if (start >= list.size()) start = list.size() > 0 ? list.size() - 1 : 0;
            i.sss("qj.idx", "" + start);
            i.syso("READER loaded pages=" + list.size() + " start=" + start);

            activity.runOnUiThread(new Runnable() {
                public void run() { reader_render(); }
            });
        }
    }).start();
}

public String reader_html(String frag) {
    String sp = String.valueOf(i.sss("qj.font"));
    boolean dark = ui_dark();
    String bg = dark ? "#121511" : "#FBF8F1";
    String fg = dark ? "#E3E3DA" : "#1B1C18";
    String css = "<style>body{margin:0;padding:24px;font-size:" + sp + "px;line-height:1.75;color:" + fg
        + ";background:" + bg + ";font-family:sans-serif;}img{max-width:100%;height:auto;display:block;margin:10px auto;}p{margin:0 0 .9em;}</style>";
    return "<html><head><meta name='viewport' content='width=device-width, initial-scale=1'>" + css
        + "</head><body>" + frag + "</body></html>";
}

public void reader_render() {
    ArrayList list = (ArrayList) i.sss("qj.read.contents");
    int idx = Integer.parseInt(String.valueOf(i.sss("qj.idx")));
    int total = Integer.parseInt(String.valueOf(i.sss("qj.read.total")));
    if (total <= 0 && list != null) total = list.size();

    TextView title = (TextView) activity.findViewById(4);
    if (title != null) {
        try {
            title.setText((new JSONObject((String) i.sss("qj.item"))).optString("title"));
        } catch (Throwable t) {
        }
    }

    TextView pg = (TextView) activity.findViewById(15);
    if (pg != null) {
        String suffix = (idx == total - 1 && total > 0) ? " · 已读完" : "";
        pg.setText((idx + 1) + " / " + total + suffix);
    }

    WebView wv = (WebView) activity.findViewById(7);
    if (wv == null) return;
    if (list == null || list.size() == 0) {
        wv.loadDataWithBaseURL("https://gede.5read.com/",
            reader_html("<p style='text-align:center;margin-top:40vh'>加载失败<br/>返回后重试</p>"),
            "text/html", "utf-8", null);
        return;
    }
    wv.loadDataWithBaseURL("https://gede.5read.com/", reader_html((String) list.get(idx)), "text/html", "utf-8", null);
    wv.scrollTo(0, 0);

    try {
        String itemJson = (String) i.sss("qj.item");
        if (itemJson != null && list.size() > 0) store_saveHistory(itemJson, idx + 1, total);
    } catch (Throwable t) {
        i.syso("READER save fail " + t);
    }
}

public void prev(Object arg) {
    i.fn("qj_ui"); i.fn("qj_store");
    reader_step(-1);
}

public void next(Object arg) {
    i.fn("qj_ui"); i.fn("qj_store");
    reader_step(1);
}

public void reader_step(int d) {
    int idx = Integer.parseInt(String.valueOf(i.sss("qj.idx")));
    int total = Integer.parseInt(String.valueOf(i.sss("qj.read.total")));
    if (total <= 0) return;
    int n = idx + d;
    if (n < 0 || n >= total) {
        android.widget.Toast.makeText(activity, d < 0 ? "前面没有啦" : "后面没有啦", 0).show();
        return;
    }
    i.sss("qj.idx", "" + n);
    reader_render();
}

public void font(Object sp) {
    i.fn("qj_ui"); i.fn("qj_store");
    i.sss("qj.font", String.valueOf(sp));
    reader_tintFonts();
    reader_render();
}

public void toc(Object arg) {
    i.fn("qj_ui"); i.fn("qj_store");
    Object o = i.sss("qj.read.catalogs");
    if (o == null) return;
    JSONArray cats = (JSONArray) o;
    try {
        String[] titles = new String[cats.length()];
        for (int k = 0; k < cats.length(); k++) {
            JSONObject c = cats.getJSONObject(k);
            titles[k] = c.optString("title") + "   p" + c.optInt("page");
        }
        new MaterialAlertDialogBuilder(activity)
            .setTitle("目录")
            .setItems(titles, new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface d, int which) {
                    try {
                        JSONArray cs = (JSONArray) i.sss("qj.read.catalogs");
                        int ci = cs.getJSONObject(which).optInt("contentIndex");
                        i.sss("qj.idx", "" + ci);
                        reader_render();
                    } catch (Throwable t) {
                        i.syso("READER toc jump fail " + t);
                    }
                }
            })
            .show();
    } catch (Throwable t) {
        i.syso("READER toc fail " + t);
    }
}

public void backKey(String tag, Object kc) {
    int c = -1;
    try { c = Integer.parseInt(String.valueOf(kc)); } catch (Throwable t) { }
    if (c == 4) activity.finish();
}

public void back(Object kc) {
    int c = -1;
    try {
        c = Integer.parseInt(String.valueOf(kc));
    } catch (Throwable t) {
    }
    if (c == 4) activity.finish();
}
