public String reader_html(String frag) {
    i.fn("qj_ui"); i.fn("qj_set");   // 每个入口都要自己 import：iyu 事件每次是新解释器
    return "<html><head><meta name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0'>"
        + set_css() + "</head><body>" + frag + "</body></html>";
}

// 阅读页专用 loading：骨架行 + 流光，比转圈更贴阅读语境
public String reader_loadingHtml() {
    i.fn("qj_ui"); i.fn("qj_set");
    boolean dark = set_dark();
    String bg = set_hex("surface");
    String sk = dark ? "linear-gradient(90deg,#24271F 25%,#333630 37%,#24271F 63%)"
                     : "linear-gradient(90deg,#EFEBE2 25%,#F8F5EE 37%,#EFEBE2 63%)";
    String tip = set_hex("onSurfaceVariant");
    String css = "<style>html,body{margin:0;background:" + bg + ";}"
        + "body{padding:24px;font-family:sans-serif;}"
        + "@keyframes qjsh{0%{background-position:-260px 0}100%{background-position:260px 0}}"
        + ".sk{height:14px;border-radius:7px;margin:0 0 18px;background:" + sk
        + ";background-size:520px 100%;animation:qjsh 1.4s infinite linear;}"
        + ".tip{margin-top:28px;text-align:center;font-size:13px;color:" + tip + ";letter-spacing:.08em}"
        + "</style>";
    String[] widths = {"92%", "100%", "86%", "96%", "78%", "100%", "90%", "62%"};
    String lines = "";
    for (int k = 0; k < widths.length; k++) {
        lines += "<div class='sk' style='width:" + widths[k] + "'></div>";
    }
    return "<html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'>"
        + css + "</head><body>" + lines + "<div class='tip'>正在翻开书页…</div></body></html>";
}

public void reader_load() {
    new Thread(new Runnable() {
        public void run() {
            try {
                String itemJson = (String) i.sss("qj.item");
                if (itemJson == null) {
                    i.syso("READER no item");
                    return;
                }
                JSONObject it = new JSONObject(itemJson);
                i.sss("qj.read.key", it.optString("key"));
                String surl = it.optString("surl");
                if (surl == null || surl.length() == 0) {
                    i.syso("READER no surl key=" + it.optString("key"));
                    activity.runOnUiThread(new Runnable() {
                        public void run() { reader_error(); }
                    });
                    return;
                }
                // 一次拿「目录 + 前 30 页」，翻 2–30 页不用再请求
                HashMap meta = core_readPage(surl, 18, 1, 30);
                JSONArray cats = (JSONArray) meta.get("catalogs");
                JSONArray first = (JSONArray) meta.get("contents");
                int total = reader_i(meta.get("pageAll"), 0);

                ArrayList list = new ArrayList();
                for (int k = 0; k < total; k++) list.add(null);
                if (first != null) {
                    for (int k = 0; k < first.length(); k++) {
                        if (k < total) list.set(k, first.optString(k));
                    }
                    if (total > 0) {
                        store_cache("chunk_" + it.optString("key") + "_0", first.toString());
                    }
                }

                i.sss("qj.read.contents", list);
                i.sss("qj.read.catalogs", cats);
                i.sss("qj.read.total", "" + total);

                int start = reader_i(i.sss("qj.page"), 1) - 1;
                if (start < 0) start = 0;
                if (total > 0 && start >= total) start = total - 1;
                i.sss("qj.idx", "" + start);
                i.syso("READER meta pages=" + total + " start=" + start);

                activity.runOnUiThread(new Runnable() {
                    public void run() { reader_render(); }
                });
            } catch (Throwable t) {
                i.syso("READER load fail " + t);
                activity.runOnUiThread(new Runnable() {
                    public void run() { reader_error(); }
                });
            }
        }
    }).start();
}

public void reader_error() {
    WebView wv = (WebView) activity.findViewById(7);
    if (wv == null) return;
    wv.loadDataWithBaseURL(core_web(),
        reader_html("<p style='text-align:center;margin-top:40vh'>加载失败<br/>返回后重试</p>"),
        "text/html", "utf-8", null);
}

public void reader_render() {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_set");
    ArrayList list = (ArrayList) i.sss("qj.read.contents");
    int idx = reader_i(i.sss("qj.idx"), 0);
    int total = reader_i(i.sss("qj.read.total"), 0);
    if (total <= 0 && list != null) total = list.size();
    if (list == null || list.size() == 0) {
        reader_error();
        return;
    }
    if (idx < 0) idx = 0;
    if (idx >= list.size()) idx = list.size() - 1;
    i.sss("qj.idx", "" + idx);

    TextView title = (TextView) activity.findViewById(4);
    if (title != null) {
        try {
            title.setText((new JSONObject((String) i.sss("qj.item"))).optString("title"));
        } catch (Throwable t) {
        }
    }

    TextView pg = (TextView) activity.findViewById(15);
    if (pg != null) {
        String suffix = (idx == total - 1 && total > 0) ? " · 已读完" : "";
        pg.setText((idx + 1) + " / " + total + suffix);
    }

    if (list.get(idx) == null) {
        reader_ensure(idx);
        return;
    }

    WebView wv = (WebView) activity.findViewById(7);
    if (wv == null) return;
    wv.loadDataWithBaseURL(core_web(), reader_html((String) list.get(idx)), "text/html", "utf-8", null);
    wv.scrollTo(0, 0);

    try {
        String itemJson = (String) i.sss("qj.item");
        if (itemJson != null) store_saveHistory(itemJson, idx + 1, total);
    } catch (Throwable t) {
        i.syso("READER save fail " + t);
    }
}

public void reader_fill(ArrayList list, int startIdx, JSONArray arr) {
    if (list == null || arr == null) return;
    for (int k = 0; k < arr.length(); k++) {
        int pos = startIdx + k;
        if (pos >= 0 && pos < list.size()) list.set(pos, arr.optString(k));
    }
}

// 按 30 页一段补内容：缺口所在段拉一次，落盘缓存
public void reader_ensure(int idx) {
    int startIdx = (idx / 30) * 30;
    i.sss("qj.chunk.start", "" + startIdx);
    String ck = "chunk_" + reader_s(i.sss("qj.read.key")) + "_" + startIdx;
    String cached = store_cacheGet(ck);
    if (cached != null) {
        try {
            JSONArray arr = new JSONArray(cached);
            reader_fill((ArrayList) i.sss("qj.read.contents"), startIdx, arr);
            i.syso("READER chunk cache " + startIdx);
            reader_render();
            return;
        } catch (Throwable t) {
            i.syso("READER chunk cache fail " + t);
        }
    }

    WebView wv = (WebView) activity.findViewById(7);
    if (wv != null) {
        wv.loadDataWithBaseURL(core_web(), reader_loadingHtml(), "text/html", "utf-8", null);
    }

    new Thread(new Runnable() {
        public void run() {
            try {
                String itemJson = (String) i.sss("qj.item");
                String surl = (new JSONObject(itemJson)).optString("surl");
                int st = reader_i(i.sss("qj.chunk.start"), 0);
                HashMap h = core_readPage(surl, 18, st + 1, 30);
                JSONArray arr = (JSONArray) h.get("contents");
                if (arr == null) {
                    i.syso("READER chunk empty " + st);
                    return;
                }
                store_cache("chunk_" + reader_s(i.sss("qj.read.key")) + "_" + st, arr.toString());
                i.sss("qj.chunk.arr", arr);
                i.syso("READER chunk loaded " + st + " n=" + arr.length());
                activity.runOnUiThread(new Runnable() {
                    public void run() {
                        JSONArray a2 = (JSONArray) i.sss("qj.chunk.arr");
                        reader_fill((ArrayList) i.sss("qj.read.contents"),
                                    reader_i(i.sss("qj.chunk.start"), 0), a2);
                        reader_render();
                    }
                });
            } catch (Throwable t) {
                i.syso("READER chunk fail " + t);
            }
        }
    }).start();
}

public void prev(Object arg) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_set");
    reader_step(-1);
}

public void next(Object arg) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_set");
    reader_step(1);
}

public void reader_step(int d) {
    int idx = reader_i(i.sss("qj.idx"), 0);
    int total = reader_i(i.sss("qj.read.total"), 0);
    if (total <= 0) return;
    int n = idx + d;
    if (n < 0 || n >= total) {
        android.widget.Toast.makeText(activity, d < 0 ? "前面没有啦" : "后面没有啦", 0).show();
        return;
    }
    i.sss("qj.idx", "" + n);
    reader_render();
}

// 目录：原生 BottomSheetDialog，与「选择期次」同一套观感（贴底 + 只圆上边两角）
public void toc(Object arg) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store");
    Object o = i.sss("qj.read.catalogs");
    if (o == null) return;
    JSONArray cats = (JSONArray) o;
    try {
        closeToc(0);
        int curPage = reader_i(i.sss("qj.idx"), 0) + 1;
        int curCat = 0;
        for (int k = 0; k < cats.length(); k++) {
            if (cats.getJSONObject(k).optInt("page") <= curPage) curCat = k;
        }
        i.sss("qj.toc.cur", "" + curCat);

        int sh = activity.getResources().getDisplayMetrics().heightPixels;
        BottomSheetDialog dlg = new BottomSheetDialog(activity);

        LinearLayout root = new LinearLayout(activity);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setLayoutParams(new FrameLayout.LayoutParams(-1, (int) (sh * 0.86f)));

        View grip = new View(activity);
        GradientDrawable gbg = new GradientDrawable();
        gbg.setColor(ui_c("outline"));
        gbg.setCornerRadius(ui_dp(2));
        grip.setBackground(gbg);
        LinearLayout.LayoutParams glp = new LinearLayout.LayoutParams(ui_dp(32), ui_dp(4));
        glp.gravity = android.view.Gravity.CENTER_HORIZONTAL;
        glp.topMargin = ui_dp(10);
        root.addView(grip, glp);

        TextView ht = new TextView(activity);
        ht.setText("目录");
        ht.setTextSize(20);
        ht.setTypeface(Typeface.create("serif", Typeface.BOLD));
        ht.setTextColor(ui_c("onSurface"));
        LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(-1, -2);
        hlp.leftMargin = ui_dp(20);
        hlp.rightMargin = ui_dp(20);
        hlp.topMargin = ui_dp(6);
        root.addView(ht, hlp);

        TextView hs = new TextView(activity);
        hs.setText("共 " + cats.length() + " 章 · 当前第 " + curPage + " 页");
        hs.setTextSize(13);
        hs.setTextColor(ui_c("onSurfaceVariant"));
        LinearLayout.LayoutParams slp = new LinearLayout.LayoutParams(-1, -2);
        slp.leftMargin = ui_dp(20);
        slp.rightMargin = ui_dp(20);
        slp.topMargin = ui_dp(2);
        slp.bottomMargin = ui_dp(8);
        root.addView(hs, slp);

        NestedScrollView sv = new NestedScrollView(activity);
        sv.setVerticalScrollBarEnabled(false);
        sv.setOverScrollMode(View.OVER_SCROLL_NEVER);
        LinearLayout list = new LinearLayout(activity);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(0, ui_dp(4), 0, ui_dp(16));
        sv.addView(list, new FrameLayout.LayoutParams(-1, -2));
        root.addView(sv, new LinearLayout.LayoutParams(-1, 0, 1));
        i.sss("qj.toc.sv", sv);
        i.sss("qj.toc.list", list);

        for (int k = 0; k < cats.length(); k++) {
            JSONObject c = cats.getJSONObject(k);
            boolean on = (k == curCat);

            LinearLayout row = new LinearLayout(activity);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(android.view.Gravity.CENTER_VERTICAL);
            row.setPadding(ui_dp(24), ui_dp(12), ui_dp(24), ui_dp(12));
            LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(-1, -2);
            rlp.leftMargin = ui_dp(12);
            rlp.rightMargin = ui_dp(12);
            rlp.topMargin = ui_dp(4);
            rlp.bottomMargin = ui_dp(4);
            row.setLayoutParams(rlp);
            if (on) {
                GradientDrawable rbg = new GradientDrawable();
                rbg.setColor(ui_c("primaryContainer"));
                rbg.setCornerRadius(ui_dp(12));
                ui_rippleOn(row, rbg);
            } else {
                ui_rippleView(row, 12);
            }

            TextView tv = new TextView(activity);
            tv.setText(c.optString("title"));
            tv.setTextSize(14);
            tv.setTextColor(on ? ui_c("onPrimaryContainer") : ui_c("onSurface"));
            tv.setTypeface(null, on ? Typeface.BOLD : Typeface.NORMAL);
            tv.setMaxLines(3);
            tv.setEllipsize(null);
            row.addView(tv, new LinearLayout.LayoutParams(0, -2, 1));

            TextView pv = new TextView(activity);
            pv.setText("p" + c.optInt("page"));
            pv.setTextSize(13);
            pv.setTextColor(on ? ui_c("onPrimaryContainer") : ui_c("onSurfaceVariant"));
            LinearLayout.LayoutParams plp = new LinearLayout.LayoutParams(-2, -2);
            plp.leftMargin = ui_dp(12);
            row.addView(pv, plp);

            row.setTag("" + k);
            row.setOnClickListener(new View.OnClickListener() {
                public void onClick(View v) {
                    int which = Integer.parseInt(String.valueOf(v.getTag()));
                    closeToc(0);
                    toc_jump(which);
                }
            });
            list.addView(row);
        }

        dlg.setContentView(root);
        dlg.setCanceledOnTouchOutside(true);
        dlg.setOnDismissListener(new DialogInterface.OnDismissListener() {
            public void onDismiss(DialogInterface di) {
                i.sss("qj.toc.dlg", "");
            }
        });
        i.sss("qj.toc.dlg", dlg);
        dlg.show();

        // 抽屉底色跟主题走；只留上边两角 = Material 原生形状，不自己画
        try {
            View panel = (View) root.getParent();
            Drawable bd = panel == null ? null : panel.getBackground();
            if (bd instanceof MaterialShapeDrawable) {
                ((MaterialShapeDrawable) bd).setFillColor(ColorStateList.valueOf(ui_c("surface")));
            }
            dlg.getBehavior().setSkipCollapsed(true);
            dlg.getBehavior().setState(BottomSheetBehavior.STATE_EXPANDED);
        } catch (Throwable t) {
            i.syso("TOC style fail " + t);
        }

        // 抽屉要先完成布局才量得到行高，延迟一点再滚到当前章
        sv.postDelayed(new Runnable() {
            public void run() {
                NestedScrollView s2 = (NestedScrollView) i.sss("qj.toc.sv");
                LinearLayout l = (LinearLayout) i.sss("qj.toc.list");
                if (s2 == null || l == null) return;
                int c2 = reader_i(i.sss("qj.toc.cur"), 0);
                if (c2 < l.getChildCount()) s2.scrollTo(0, l.getChildAt(c2).getTop() - ui_dp(32));
            }
        }, 260L);
    } catch (Throwable t) {
        i.syso("READER toc fail " + t);
    }
}

public void closeToc(Object arg) {
    Object d = i.sss("qj.toc.dlg");
    i.sss("qj.toc.dlg", "");
    if (d instanceof BottomSheetDialog) {
        try { ((BottomSheetDialog) d).dismiss(); } catch (Throwable t) { }
    }
}

public void noop(Object arg) {
}

public void toc_jump(int which) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_set");
    try {
        JSONArray cs = (JSONArray) i.sss("qj.read.catalogs");
        int ci = cs.getJSONObject(which).optInt("page") - 1;
        if (ci < 0) ci = 0;
        int total = reader_i(i.sss("qj.read.total"), 0);
        if (total > 0 && ci >= total) ci = total - 1;
        i.sss("qj.idx", "" + ci);
        reader_render();
    } catch (Throwable t) {
        i.syso("READER toc jump fail " + t);
    }
}

public void backKey(String tag, Object kc) {
    int c = -1;
    try { c = Integer.parseInt(reader_s(kc)); } catch (Throwable t) { }
    if (c == 4) activity.finish();
}

public void back(Object kc) {
    int c = -1;
    try {
        c = Integer.parseInt(reader_s(kc));
    } catch (Throwable t) {
    }
    if (c == 4) activity.finish();
}

public String reader_s(Object o) {
    return o == null ? "" : String.valueOf(o);
}

public int reader_i(Object o, int def) {
    try {
        return Integer.parseInt(reader_s(o));
    } catch (Throwable t) {
        return def;
    }
}
