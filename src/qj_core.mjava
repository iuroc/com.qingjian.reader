// ---------- 阅读 ----------

public String core_match(String body, String regex) {
    try {
        Matcher m = Pattern.compile(regex).matcher(body);
        if (m.find()) return m.group(1);
    } catch (Throwable t) {
        i.syso("CORE match fail " + t);
    }
    return null;
}

public HashMap core_read(String surl, int fsize) {
    HashMap out = new HashMap();
    try {
        String fixed = core_fixSurl(surl);
        String page = core_get("https://gede.5read.com/o/a.h?a=GEDE:" + URLEncoder.encode(fixed, "UTF-8"));
        if (page == null) { i.syso("CORE read bootstrap null"); return out; }

        String du = core_match(page, "detailUrl:\\s*'([^']+)'");
        String sid = core_match(page, "sid:\\s*'([^']*)'");
        String from = core_match(page, "from:\\s*'([^']*)'");
        if (du == null || sid == null || from == null) {
            i.syso("CORE read token fail du=" + (du != null) + " sid=" + (sid != null) + " from=" + (from != null));
            return out;
        }

        String u = "https://gede.5read.com/other/epub_epubRead_readNew.jspx?psize=10000&ucatalog=true&ctype=3"
            + "&fsize=" + fsize + "&sid=" + URLEncoder.encode(sid, "UTF-8")
            + "&from=" + from + "&detailUrl=" + URLEncoder.encode(du, "UTF-8");
        String body = core_get(u);
        if (body == null) { i.syso("CORE read body null"); return out; }

        JSONObject jo = new JSONObject(body);
        if (jo.optInt("result") != 1) {
            i.syso("CORE read result=" + jo.optInt("result") + " " + jo.optString("errorMsg"));
            return out;
        }
        JSONObject msg = jo.getJSONObject("msg");
        out.put("contents", msg.getJSONArray("contents"));
        out.put("catalogs", msg.getJSONArray("catalogs"));
        out.put("pageAll", "" + msg.optInt("pageAll"));
    } catch (Throwable t) {
        i.syso("CORE read fail " + t);
    }
    return out;
}
