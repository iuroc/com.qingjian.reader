// 青简 · 数据层。方法统一 core_ 前缀。全部同步阻塞，调用方自己放后台线程。

import java.net.URLEncoder;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.json.JSONObject;
import org.json.JSONArray;


// 主机名与借阅机 ID 以 XOR 整数数组存放，运行时还原；只避免源码明文，不防抓包（已接受风险）
public String core_decoded() {
    int[] enc = {22, 15, 73, 87, 30, 7, 68, 72, 16, 13, 64, 4, 5, 4, 29, 86, 69, 93, 24, 3, 6, 1, 14};
    String key = "qj-2026-qingjian";
    StringBuilder sb = new StringBuilder();
    for (int k = 0; k < enc.length; k++) {
        sb.append((char) (enc[k] ^ (int) key.charAt(k % key.length())));
    }
    return sb.toString();
}

public String core_host() {
    String s = core_decoded();
    int p = s.indexOf('|');
    return p < 0 ? s : s.substring(0, p);
}

public String core_gedeid() {
    String s = core_decoded();
    int p = s.indexOf('|');
    return p < 0 ? "" : s.substring(p + 1);
}

public String core_api(String path) {
    return "https://" + core_host() + "/apis/" + path;
}

public String core_web() {
    return "https://" + core_host() + "/";
}

public String core_get(String url) {
    try {
        return i.hs(url);
    } catch (Throwable t) {
        i.syso("CORE get fail " + t);
        return null;
    }
}

public String core_fixSurl(String surl) {
    if (surl == null) return "";
    if (surl.startsWith("http")) return surl;
    return "https://" + surl;
}

// ---------- 列表 ----------

public ArrayList core_books(int cataid, int page, int size) {
    String u = core_api("touchBook/books.jspx?cataid=" + cataid + "&page=" + page
        + "&pageSize=" + size + "&gedeid=" + core_gedeid());
    return core_parseBooks(core_get(u));
}

public ArrayList core_search(String kw, int page, int size) {
    String q = "";
    try { q = URLEncoder.encode(kw, "UTF-8"); } catch (Throwable t) { q = kw; }
    String u = core_api("touchBook/books.jspx?keyword=" + q + "&page=" + page
        + "&pageSize=" + size + "&gedeid=" + core_gedeid());
    return core_parseBooks(core_get(u));
}

public ArrayList core_parseBooks(String body) {
    ArrayList out = new ArrayList();
    if (body == null) return out;
    try {
        JSONObject jo = new JSONObject(body);
        if (jo.optInt("result") != 1) {
            i.syso("CORE books result=" + jo.optInt("result") + " " + jo.optString("errorMsg"));
            return out;
        }
        JSONArray arr = jo.getJSONObject("msg").getJSONArray("list");
        for (int k = 0; k < arr.length(); k++) {
            JSONObject o = arr.getJSONObject(k);
            HashMap m = new HashMap();
            String num = o.optString("bookNum");
            m.put("key", num);
            m.put("type", "ebook");
            m.put("title", o.optString("title"));
            m.put("author", o.optString("author"));
            m.put("summary", o.optString("summary"));
            m.put("cover", o.optString("cover"));
            m.put("surl", o.optString("surl"));
            m.put("bookNum", num);
            m.put("newbook", "" + o.optInt("newbook"));
            out.add(m);
        }
    } catch (Throwable t) {
        i.syso("CORE parseBooks fail " + t);
    }
    return out;
}

