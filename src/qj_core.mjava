// ---------- 阅读 ----------

public String core_match(String body, String regex) {
    if (body == null) return null;
    try {
        Matcher m = Pattern.compile(regex).matcher(body);
        if (m.find()) return m.group(1);
    } catch (Throwable t) {
        i.syso("CORE match fail " + t);
    }
    return null;
}

public ArrayList core_allBooks() {
    int[] ids = {124, 125, 126, 127, 128, 129, 130, 131, 132, 140, 141};
    ArrayList all = new ArrayList();
    HashMap seen = new HashMap();
    for (int k = 0; k < ids.length; k++) {
        ArrayList part = core_books(ids[k], 1, -1);
        for (int j = 0; j < part.size(); j++) {
            HashMap m = (HashMap) part.get(j);
            String key = (String) m.get("key");
            if (!seen.containsKey(key)) {
                seen.put(key, "1");
                all.add(m);
            }
        }
        i.syso("CORE allBooks cat=" + ids[k] + " total=" + all.size());
    }
    return all;
}

// 阅读 token 缓存（同一个 surl 只 bootstrap 一次）
public HashMap core_tok(String surl) {
    String key = "qj.tok." + surl;
    Object o = i.sss(key);
    if (o != null) return (HashMap) o;
    HashMap t = new HashMap();
    try {
        String fixed = core_fixSurl(surl);
        String tokUrl = core_web() + "o/a.h?a=GEDE:" + URLEncoder.encode(fixed, "UTF-8");
        String page = core_get(tokUrl);
        i.syso("CORE tok url=" + tokUrl + " body=" + (page == null ? "null" : "" + page.length()));
        t.put("du", core_match(page, "detailUrl:\\s*'([^']+)'"));
        t.put("sid", core_match(page, "sid:\\s*'([^']*)'"));
        t.put("from", core_match(page, "from:\\s*'([^']*)'"));
        i.sss(key, t);
    } catch (Throwable e) {
        i.syso("CORE tok fail " + e);
    }
    return t;
}

// 分段读取：page 是 1 基内容起点（page=31 从第 31 页开始），psize 是本段页数。
// w/h 是虚拟阅读器尺寸，只影响服务端分页；固定传同一组值，保证 pageAll 与目录页号一致。
public HashMap core_readPage(String surl, int fsize, int page1, int psize) {
    HashMap out = new HashMap();
    try {
        HashMap t = core_tok(surl);
        String du = (String) t.get("du");
        String sid = (String) t.get("sid");
        String from = (String) t.get("from");
        if (du == null || sid == null || from == null) {
            i.syso("CORE readPage token missing");
            return out;
        }
        String u = core_web() + "other/epub_epubRead_readNew.jspx?psize=" + psize
            + "&page=" + page1 + "&w=1000&h=2000&ucatalog=true&ctype=3&fsize=" + fsize
            + "&sid=" + URLEncoder.encode(sid, "UTF-8")
            + "&from=" + from
            + "&detailUrl=" + URLEncoder.encode(du, "UTF-8");
        String body = core_get(u);
        JSONObject jo = new JSONObject(body);
        if (jo.optInt("result") != 1) {
            i.syso("CORE readPage result=" + jo.optInt("result") + " " + jo.optString("errorMsg"));
            return out;
        }
        JSONObject msg = jo.getJSONObject("msg");
        out.put("contents", msg.getJSONArray("contents"));
        out.put("catalogs", msg.getJSONArray("catalogs"));
        out.put("pageAll", "" + msg.optInt("pageAll"));
    } catch (Throwable e) {
        i.syso("CORE readPage fail " + e);
    }
    return out;
}
