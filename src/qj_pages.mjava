public HashMap pages_mapOf(JSONObject o) {
    HashMap m = new HashMap();
    m.put("key", o.optString("key"));
    m.put("type", o.optString("type"));
    m.put("title", o.optString("title"));
    m.put("author", o.optString("author"));
    m.put("summary", o.optString("summary"));
    m.put("cover", o.optString("cover"));
    m.put("surl", o.optString("surl"));
    m.put("bookNum", o.optString("bookNum"));
    m.put("magazineId", o.optString("magazineId"));
    m.put("newbook", o.optString("newbook"));
    return m;
}

public ArrayList pages_cacheList(String key) {
    String s = store_cacheGet(key);
    if (s == null) return null;
    try {
        JSONArray arr = new JSONArray(s);
        ArrayList out = new ArrayList();
        for (int k = 0; k < arr.length(); k++) out.add(pages_mapOf(arr.getJSONObject(k)));
        i.syso("QJ cache hit " + key + " n=" + out.size());
        return out;
    } catch (Throwable t) {
        i.syso("QJ cache " + key + " fail " + t);
        return null;
    }
}

public String pages_jsonOf(ArrayList list) {
    try {
        JSONArray arr = new JSONArray();
        for (int k = 0; k < list.size(); k++) arr.put(new JSONObject((HashMap) list.get(k)));
        return arr.toString();
    } catch (Throwable t) {
        i.syso("QJ jsonOf fail " + t);
        return "[]";
    }
}

public void pages_indexStart() {
    String st = pages_s(i.sss("qj.idx.state"));
    if ("ready".equals(st)) return;
    if ("building".equals(st)) {
        long ts = 0;
        try { ts = Long.parseLong(pages_s(i.sss("qj.idx.ts"))); } catch (Throwable t) { }
        long now = System.currentTimeMillis() / 1000;
        if (ts > 0 && now - ts < 60) return;
        i.syso("QJ idx stale, restart");
    }
    i.sss("qj.idx.state", "building");
    i.sss("qj.idx.ts", "" + (System.currentTimeMillis() / 1000));
    i.sss("qj.prog.done", "0");
    i.sss("qj.prog.total", "18");
    new Thread(new Runnable() {
        public void run() {
            try {
                int total = 18;
                int done = 0;

                ArrayList books = pages_cacheList("idx_books");
                if (books == null) {
                    int[] ids = {124, 125, 126, 127, 128, 129, 130, 131, 132, 140, 141};
                    books = new ArrayList();
                    HashMap seen = new HashMap();
                    for (int k = 0; k < ids.length; k++) {
                        ArrayList part = core_books(ids[k], 1, -1);
                        for (int j = 0; j < part.size(); j++) {
                            HashMap m = (HashMap) part.get(j);
                            String key = (String) m.get("key");
                            if (!seen.containsKey(key)) {
                                seen.put(key, "1");
                                books.add(m);
                            }
                        }
                        done++;
                        pages_progress(done, total);
                    }
                    store_cache("idx_books", pages_jsonOf(books));
                } else {
                    done = 11;
                    pages_progress(done, total);
                }
                i.sss("qj.idx.books", books);
                i.syso("QJ idx books=" + books.size());

                ArrayList mags = pages_cacheList("idx_mags");
                if (mags == null) {
                    int[] mids = {6, 3, 4, 5, 8, 9, 10};
                    mags = new ArrayList();
                    HashMap seen2 = new HashMap();
                    for (int k = 0; k < mids.length; k++) {
                        ArrayList part = core_magazines(mids[k], 1, -1);
                        for (int j = 0; j < part.size(); j++) {
                            HashMap m = (HashMap) part.get(j);
                            String key = (String) m.get("key");
                            if (!seen2.containsKey(key)) {
                                seen2.put(key, "1");
                                mags.add(m);
                            }
                        }
                        done++;
                        pages_progress(done, total);
                    }
                    store_cache("idx_mags", pages_jsonOf(mags));
                } else {
                    done = total;
                    pages_progress(done, total);
                }
                i.sss("qj.idx.mags", mags);
                i.syso("QJ idx mags=" + mags.size());

                i.sss("qj.idx.state", "ready");
                pages_progress(total, total);
                pages_statusUi();
                activity.runOnUiThread(new Runnable() {
                    public void run() { pages_refireSearch(); }
                });
            } catch (Throwable t) {
                i.syso("QJ idx fail " + t);
                i.sss("qj.idx.state", "failed");
                pages_statusUi();
            }
        }
    }).start();
}

public void pages_progress(int done, int total) {
    i.sss("qj.prog.done", "" + done);
    i.sss("qj.prog.total", "" + total);
    i.sss("qj.idx.ts", "" + (System.currentTimeMillis() / 1000));
}

public void pages_refireSearch() {
    if (activity.findViewById(8) == null) return;
    String kw = pages_s(i.sss("qj.kw"));
    if (kw.length() == 0) return;
    ArrayList books = pages_filter(i.sss("qj.idx.books"), kw);
    ArrayList mags = pages_filter(i.sss("qj.idx.mags"), kw);
    i.sss("qj.res.books", books);
    i.sss("qj.res.mags", mags);
    i.syso("QJ search refire kw=" + kw + " books=" + books.size() + " mags=" + mags.size());
    pages_renderResults();
}

public void pages_rebuild(Object arg) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_list");
    new MaterialAlertDialogBuilder(activity)
        .setTitle("重建索引？")
        .setMessage("会重新拉取全部图书与期刊（约 18 个请求），并覆盖当前缓存。")
        .setNegativeButton("取消", null)
        .setPositiveButton("重建", new DialogInterface.OnClickListener() {
            public void onClick(DialogInterface d, int w) {
                store_cacheClear("idx_books");
                store_cacheClear("idx_mags");
                i.sss("qj.idx.state", "none");
                i.sss("qj.idx.books", null);
                i.sss("qj.idx.mags", null);
                i.sss("qj.prog.done", "0");
                i.sss("qj.prog.total", "18");
                pages_renderIdle();
                pages_indexStart();
                pages_poll();
            }
        })
        .show();
}

