public void pages_fabShow(boolean show) {
    i.sss("qj.fab.shown", show ? "1" : "0");
    if (!show) i.sss("qj.fab.acc", "0");
    View fab = activity.findViewById(170);
    if (fab == null) return;
    if (show) {
        fab.setVisibility(View.VISIBLE);
        fab.setAlpha((float) 0);
        fab.animate().alpha((float) 1).setDuration(150).start();
    } else {
        fab.setVisibility(View.GONE);
    }
}

public void pages_sticky(int sy, int oldy) {
    int dy = sy - oldy;

    // ---- 回顶按钮：离顶够远 + 出现明确的向上滚动意图 ----
    String fabShown = pages_s(i.sss("qj.fab.shown"));
    if (dy > 6) {
        // 继续向下看，说明没打算回顶
        if ("1".equals(fabShown)) pages_fabShow(false);
        i.sss("qj.fab.acc", "0");
    } else if (dy < -6) {
        int acc = pages_i(i.sss("qj.fab.acc"), 0) + (-dy);
        i.sss("qj.fab.acc", "" + acc);
        if (!"1".equals(fabShown) && sy > ui_dp(600) && acc >= ui_dp(120)) {
            pages_fabShow(true);
        }
    }
    if (sy < ui_dp(300) && "1".equals(pages_s(i.sss("qj.fab.shown")))) {
        pages_fabShow(false);
    }

    // ---- 吸顶 Tab：往下翻收起，往上拉滑出 ----
    View head = activity.findViewById(140);
    if (head == null || head.getVisibility() != View.VISIBLE) return;
    int h = pages_i(i.sss("qj.sticky.h"), ui_dp(96));
    String shown = pages_s(i.sss("qj.sticky.show"));
    if (sy <= 4) {
        if (!"1".equals(shown)) {
            i.sss("qj.sticky.show", "1");
            head.animate().translationY((float) 0).setDuration(180).start();
        }
        return;
    }
    if (dy > 8 && "1".equals(shown)) {
        i.sss("qj.sticky.show", "0");
        head.animate().translationY((float) -h).setDuration(180).start();
    } else if (dy < -8 && !"1".equals(shown)) {
        i.sss("qj.sticky.show", "1");
        head.animate().translationY((float) 0).setDuration(180).start();
    }
}

public void pages_headPad() {
