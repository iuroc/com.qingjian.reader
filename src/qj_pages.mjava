        clp.rightMargin = ui_dp(4);
        clr.setLayoutParams(clp);
    }
    pages_renderIdle();
    pages_indexStart();
    pages_poll();
}

public String pages_idxStatusText() {
    String st = pages_s(i.sss("qj.idx.state"));
    ArrayList b = (ArrayList) i.sss("qj.idx.books");
    ArrayList m = (ArrayList) i.sss("qj.idx.mags");
    int nb = (b == null) ? 0 : b.size();
    int nm = (m == null) ? 0 : m.size();
    if ("ready".equals(st)) return "索引就绪 · 图书 " + nb + " · 期刊 " + nm;
    if ("failed".equals(st)) return "索引建立失败，点此重试";
    if ("building".equals(st)) {
        int d = pages_i(i.sss("qj.prog.done"), 0);
        int t = pages_i(i.sss("qj.prog.total"), 18);
        return "正在建立索引 · " + d + " / " + t + " · 点此可强制重建";
    }
    return "首次搜索会自动建立索引";
}

// UI 只从 i.sss 读进度：索引线程可能属于上一个页面，不能直接操作当前视图
public void pages_refreshIndexUi() {
    TextView st = (TextView) activity.findViewById(900);
    if (st == null) return;
    String state = pages_s(i.sss("qj.idx.state"));
    st.setText(pages_idxStatusText());
    LinearProgressIndicator bar = (LinearProgressIndicator) activity.findViewById(901);
    if (bar == null) return;
    if ("ready".equals(state) || "failed".equals(state)) {
        bar.setVisibility(View.GONE);
    } else if ("building".equals(state)) {
        int d = pages_i(i.sss("qj.prog.done"), 0);
        int t = pages_i(i.sss("qj.prog.total"), 18);
        if (t <= 0) t = 18;
        bar.setMax(t);
        bar.setProgress(d);
        bar.setVisibility(View.VISIBLE);
    }
}

// 建索引期间每 500ms 刷新一次；页面销毁（900 找不到）自动停
public void pages_poll() {
    View anchor = activity.findViewById(900);
    if (anchor == null) return;
    String state = pages_s(i.sss("qj.idx.state"));
    pages_refreshIndexUi();
    if ("building".equals(state)) {
        anchor.postDelayed(new Runnable() {
            public void run() { pages_poll(); }
        }, 500);
    } else if ("ready".equals(state)) {
        pages_refireSearch();
    }
}

