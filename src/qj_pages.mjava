public void clearSearch(Object arg) {
    i.fn("qj_ui"); i.fn("qj_store"); i.fn("qj_list");
    EditText et = (EditText) activity.findViewById(5);
    if (et != null) {
        et.setText("");
        et.requestFocus();
    }
    i.sss("qj.kw", "");
    i.sss("qj.res.books", null);
    i.sss("qj.res.mags", null);
    pages_syncClear();
    pages_renderIdle();
}

public void doSearch(Object arg) {
    i.fn("qj_ui"); i.fn("qj_store"); i.fn("qj_list");
    if ("1".equals(pages_s(i.sss("qj.search.busy")))) return;
    EditText et = (EditText) activity.findViewById(5);
    String kw = et == null ? "" : et.getText().toString().trim();
    if (kw.length() == 0) return;
    i.sss("qj.search.busy", "1");
    i.sss("qj.kw", kw);
    pages_syncClear();
    store_saveRecent(kw);
    pages_busyUi(true);
    pages_showLoading();
    if (!"ready".equals(pages_s(i.sss("qj.idx.state")))) pages_indexStart();
    new Thread(new Runnable() {
        public void run() {
            try {
                String k = pages_s(i.sss("qj.kw"));
                ArrayList books = pages_filter(i.sss("qj.idx.books"), k);
                ArrayList mags = pages_filter(i.sss("qj.idx.mags"), k);
                i.sss("qj.res.books", books);
                i.sss("qj.res.mags", mags);
                i.syso("QJ search kw=" + k + " books=" + books.size() + " mags=" + mags.size());
            } catch (Throwable t) {
                i.syso("QJ search fail " + t);
            }
            activity.runOnUiThread(new Runnable() {
                public void run() { pages_renderResults(); }
            });
        }
    }).start();
}

