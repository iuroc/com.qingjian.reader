public void pages_tabs() {
    TabLayout tl = (TabLayout) activity.findViewById(141);
    if (tl == null) return;
    tl.removeAllTabs();
    tl.setBackgroundColor(ui_c("surface"));
    tl.setElevation((float) 0);
    tl.setSelectedTabIndicatorColor(ui_c("primary"));
    tl.setTabTextColors(ui_c("onSurfaceVariant"), ui_c("primary"));
    tl.addTab(tl.newTab().setText("期刊"));
    tl.addTab(tl.newTab().setText("图书"));
    tl.addOnTabSelectedListener(new TabLayout.OnTabSelectedListener() {
        public void onTabSelected(TabLayout.Tab t) { pages_kind(t.getPosition()); }
        public void onTabUnselected(TabLayout.Tab t) {}
        public void onTabReselected(TabLayout.Tab t) {}
