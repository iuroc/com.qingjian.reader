    if (back != null) {
        back.setImageBitmap(ui_iconSize("back", 48, (float) 1.8));
        back.setColorFilter(ui_c("primary"));
    }
    TextView btn = (TextView) activity.findViewById(6);
    if (btn != null) btn.setTextColor(ui_c("primary"));
    ui_ripple(3); ui_ripple(6);
    View pill = activity.findViewById(4);
    if (pill != null) {
        GradientDrawable ebg = new GradientDrawable();
        ebg.setColor(ui_c("surfaceContainer"));
        ebg.setCornerRadius(ui_dp(22));
        pill.setBackground(ebg);
    }
    EditText et = (EditText) activity.findViewById(5);
    if (et != null) {
        et.setBackground(null);
        et.setTextColor(ui_c("onSurface"));
        et.setHintTextColor(ui_c("onSurfaceVariant"));
        et.setGravity(android.view.Gravity.CENTER_VERTICAL);
        et.setPadding(ui_dp(16), 0, ui_dp(44), 0);
    }
    ImageView clr = (ImageView) activity.findViewById(12);
    if (clr != null) {
        clr.setScaleType(ImageView.ScaleType.CENTER);
        clr.setImageBitmap(ui_iconSize("close", 24, (float) 1.8));
        clr.setColorFilter(ui_c("onSurfaceVariant"));
        clr.setVisibility(View.GONE);
