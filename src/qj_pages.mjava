public ArrayList pages_filter(Object o, String kw) {
    ArrayList out = new ArrayList();
    if (o == null) return out;
    ArrayList list = (ArrayList) o;
    String k = kw.toLowerCase();
    for (int i2 = 0; i2 < list.size(); i2++) {
        HashMap m = (HashMap) list.get(i2);
        String blob = (pages_s(m.get("title")) + " " + pages_s(m.get("author"))
            + " " + pages_s(m.get("summary"))).toLowerCase();
        if (blob.indexOf(k) >= 0) out.add(m);
    }
    return out;
}

