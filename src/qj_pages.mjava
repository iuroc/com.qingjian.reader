    FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ui_dp(56), ui_dp(56));
    lp.gravity = android.view.Gravity.END | android.view.Gravity.BOTTOM;
    lp.rightMargin = ui_dp(16);
    lp.bottomMargin = ui_dp(16);
    host.addView(fab, lp);
