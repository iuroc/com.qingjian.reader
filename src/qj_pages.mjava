public void boot() {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_list");
    screen(1);
    tab(0);
}

public void tab(Object which) {
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_list");
    int w = Integer.parseInt(String.valueOf(which));
    i.sss("qj.tab", "" + w);
    ui_switch(w);
    ui_loading(false, "");
    View stickyHead = activity.findViewById(140);
    if (stickyHead != null) {
        if (w == 1) {
            stickyHead.setVisibility(View.VISIBLE);
            stickyHead.setTranslationY((float) 0);
            i.sss("qj.sticky.show", "1");
        } else {
            stickyHead.setVisibility(View.GONE);
            pages_fabShow(false);
        }
    }
    if (w == 0) home();
    if (w == 1) shelf();
    if (w == 2) trail(0);
}

// 从阅读页退回本页：弹栈复用 Activity，loading 不会再跑，只走 resume。
// 只有阅读进度真的写过（qj.hist.dirty）才重画当前这一屏，并保住滚动位置。
public void resume(Object arg) {
    if (!"1".equals(i.sss("qj.hist.dirty"))) return;
    i.sss("qj.hist.dirty", "0");
    i.fn("qj_ui"); i.fn("qj_core"); i.fn("qj_store"); i.fn("qj_list");
    Object t = i.sss("qj.tab");
    int w = 0;
    try {
        w = Integer.parseInt(t == null ? "0" : String.valueOf(t));
    } catch (Throwable e) {
        w = 0;
    }
    if (w == 1) return;                                  // 书刊列表不显示进度
    ScrollView sv = (ScrollView) activity.findViewById(w == 0 ? 10 : 12);
    int y = sv == null ? 0 : sv.getScrollY();
    if (w == 0) home(); else trail(0);
    if (sv != null && y > 0) {
        // 重画后子视图要重新量高，直接 scrollTo 会被旧高度夹住，等一帧再滚
        sv.postDelayed(new Runnable() {
            public void run() { sv.scrollTo(0, y); }
        }, 60L);
    }
}

// ---------- 精选 ----------

public void home() {
    if ("1".equals(i.sss("qj.home.loaded"))) {
        pages_renderHome();
        return;
    }
    ui_loading(true, "正在加载精选…");
    new Thread(new Runnable() {
        public void run() {
            ArrayList mags = core_magazines(6, 1, 6);
            ArrayList b1 = core_books(124, 1, 20);
            ArrayList b2 = core_books(125, 1, 20);
            i.sss("qj.home.mags", mags);
            i.sss("qj.home.books", pages_pickNew(b1, b2));
            i.syso("QJ home mags=" + mags.size() + " books=" + ((ArrayList) i.sss("qj.home.books")).size());
            activity.runOnUiThread(new Runnable() {
                public void run() { pages_renderHome(); }
            });
        }
    }).start();
}

public ArrayList pages_pickNew(ArrayList a, ArrayList b) {
    ArrayList out = new ArrayList();
    for (int k = 0; k < a.size() && out.size() < 6; k++) {
        HashMap m = (HashMap) a.get(k);
        if ("1".equals(m.get("newbook"))) out.add(m);
    }
    for (int k = 0; k < b.size() && out.size() < 6; k++) {
        HashMap m = (HashMap) b.get(k);
        if ("1".equals(m.get("newbook"))) out.add(m);
    }
    for (int k = 0; k < a.size() && out.size() < 6; k++) out.add(a.get(k));
    return out;
}

public void pages_renderHome() {
    ui_loading(false, "");
    list_clear(13);
    list_searchBar(13);
    ArrayList hist = store_history();
    if (hist.size() > 0) {
        HashMap h = pages_histMap((String) hist.get(0));
        if (h != null) list_continue(13, h);
    }
    ArrayList mags2 = (ArrayList) i.sss("qj.home.mags");
    ArrayList books2 = (ArrayList) i.sss("qj.home.books");
    boolean magEmpty = (mags2 == null || mags2.size() == 0);
    boolean bookEmpty = (books2 == null || books2.size() == 0);
    if (magEmpty && bookEmpty) {
        LinearLayout host = (LinearLayout) activity.findViewById(13);
        TextView err = new TextView(activity);
        err.setText("内容加载失败，点此重试");
        err.setTextSize(16);
        err.setTextColor(ui_c("primary"));
        err.setGravity(android.view.Gravity.CENTER);
        err.setPadding(ui_dp(24), ui_dp(48), ui_dp(24), ui_dp(24));
        err.setOnClickListener(new View.OnClickListener() {
            public void onClick(View v) {
                i.sss("qj.home.loaded", "0");
                home();
            }
        });
        host.addView(err);
        return;
    }
    list_header(13, "期刊精选");
    list_cards(13, mags2);
    list_header(13, "图书新书");
    list_rows(13, books2);
    i.sss("qj.home.loaded", "1");
}

