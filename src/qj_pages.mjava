    // 否则索引轮询里 ready -> refire 会立刻把旧结果画回来
    i.sss("qj.kw", "");
    i.sss("qj.res.books", null);
    i.sss("qj.res.mags", null);
    EditText et0 = (EditText) activity.findViewById(5);
    if (et0 != null) et0.setText("");
    View root = activity.findViewById(1);
