public void pages_skeletonView(LinearLayout host, String text) {
    if (host == null) return;
    host.removeAllViews();

    LinearLayout box = new LinearLayout(activity);
    box.setOrientation(LinearLayout.VERTICAL);
    box.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
    box.setPadding(ui_dp(24), ui_dp(28), ui_dp(24), ui_dp(16));

    int[] ws = {260, 220, 240, 180, 230};
    for (int k = 0; k < ws.length; k++) {
        View bar = new View(activity);
        GradientDrawable bg = new GradientDrawable();
        bg.setColor(ui_c("divider"));
        bg.setCornerRadius(ui_dp(7));
        bar.setBackground(bg);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ui_dp(ws[k]), ui_dp(14));
        lp.bottomMargin = ui_dp(14);
        box.addView(bar, lp);
    }
    TextView t = new TextView(activity);
    t.setText(text);
    t.setTextSize(13);
    t.setTextColor(ui_c("onSurfaceVariant"));
    t.setGravity(android.view.Gravity.CENTER);
    LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(-1, -2);
    tp.topMargin = ui_dp(8);
    box.addView(t, tp);
    host.addView(box);

    // 可变参数方法在 mjava 里必须显式传数组，否则 BeanShell 按固定参数匹配会报 ofFloat not found
    ObjectAnimator anim = ObjectAnimator.ofFloat(box, "alpha", new float[]{0.45f, 1f});
    anim.setDuration(700);
    anim.setRepeatCount(ValueAnimator.INFINITE);
    anim.setRepeatMode(ValueAnimator.REVERSE);
    anim.start();
}


public void pages_moreBusy(boolean busy) {
    MaterialButton more = (MaterialButton) activity.findViewById(145);
    if (more == null) return;
    if (busy) {
        i.sss("qj.more.busy", "1");
        i.sss("qj.more.n", "0");
        more.setEnabled(false);
        more.setAlpha((float) 0.55);
        pages_moreTick();
    } else {
        i.sss("qj.more.busy", "0");
        more.setEnabled(true);
        more.setAlpha((float) 1);
        more.setText("加载更多");
    }
}

public void pages_moreTick() {
    if (!"1".equals(pages_s(i.sss("qj.more.busy")))) return;
    MaterialButton more = (MaterialButton) activity.findViewById(145);
    if (more == null) return;
    int n = pages_i(i.sss("qj.more.n"), 0);
    String dots = "";
    for (int k = 0; k < (n % 3) + 1; k++) dots += "·";
    more.setText("加载中 " + dots);
    i.sss("qj.more.n", "" + (n + 1));
    more.postDelayed(new Runnable() {
        public void run() { pages_moreTick(); }
    }, 400);
}
