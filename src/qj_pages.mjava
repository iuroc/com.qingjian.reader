public void pages_renderResults() {
    i.sss("qj.search.busy", "0");
    pages_busyUi(false);
    LinearLayout host = (LinearLayout) activity.findViewById(8);
    if (host == null) return;
    host.removeAllViews();
    String kw = pages_s(i.sss("qj.kw"));
    ArrayList books = (ArrayList) i.sss("qj.res.books");
    ArrayList mags = (ArrayList) i.sss("qj.res.mags");
    if (books == null) books = new ArrayList();
    if (mags == null) mags = new ArrayList();

    String st = pages_s(i.sss("qj.idx.state"));
    if (!"ready".equals(st)) {
        TextView tip = new TextView(activity);
        int d = pages_i(i.sss("qj.prog.done"), 0);
        int t = pages_i(i.sss("qj.prog.total"), 18);
        tip.setText("索引建立中 " + d + " / " + t + "，先显示已完成部分，完成后自动刷新");
        tip.setTextSize(13);
        tip.setTextColor(ui_c("onSurfaceVariant"));
        tip.setPadding(ui_dp(20), ui_dp(12), ui_dp(20), ui_dp(4));
        host.addView(tip);
    }

    if (books.size() == 0 && mags.size() == 0) {
        TextView empty = new TextView(activity);
        empty.setText("没有找到「" + kw + "」\n换个关键词，或试试上面的热门搜索");
        empty.setTextSize(16);
        empty.setTextColor(ui_c("onSurfaceVariant"));
        empty.setGravity(android.view.Gravity.CENTER);
        empty.setPadding(ui_dp(24), ui_dp(32), ui_dp(24), ui_dp(24));
        host.addView(empty);
        return;
    }
    if (books.size() > 0) {
        list_header(8, "图书 · " + books.size());
        list_rows(8, books);
    }
    if (mags.size() > 0) {
        list_header(8, "期刊 · " + mags.size());
        list_rows(8, mags);
    }
}


