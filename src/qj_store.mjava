// 青简 · 本地历史与缓存。方法统一 store_ 前缀。

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStreamReader;
import java.io.OutputStreamWriter;
import java.util.ArrayList;
import java.util.HashMap;
import org.json.JSONObject;

public File store_dir() {
    File d = new File(activity.getFilesDir(), "qingjian");
    if (!d.exists()) d.mkdirs();
    return d;
}

public ArrayList store_lines(File f) {
    ArrayList out = new ArrayList();
    if (!f.exists()) return out;
    try {
        BufferedReader r = new BufferedReader(new InputStreamReader(new FileInputStream(f), "UTF-8"));
        String line = r.readLine();
        while (line != null) {
            if (line.trim().length() > 0) out.add(line);
            line = r.readLine();
        }
        r.close();
    } catch (Throwable t) {
        i.syso("STORE read fail " + t);
    }
    return out;
}

public void store_write(File f, ArrayList lines) {
    try {
        StringBuilder sb = new StringBuilder();
        for (int k = 0; k < lines.size(); k++) {
            sb.append((String) lines.get(k));
            if (k < lines.size() - 1) sb.append("\n");
        }
        FileOutputStream fos = new FileOutputStream(f);
        OutputStreamWriter w = new OutputStreamWriter(fos, "UTF-8");
        w.write(sb.toString());
        w.close();
        fos.close();
    } catch (Throwable t) {
        i.syso("STORE write fail " + t);
    }
}

public void store_saveHistory(String itemJson, int page, int total) {
    try {
        JSONObject item = new JSONObject(itemJson);
        item.put("page", page);
        item.put("total", total);
        item.put("updatedAt", System.currentTimeMillis() / 1000);
        String key = item.optString("key");

        ArrayList old = store_lines(new File(store_dir(), "history.jsonl"));
        ArrayList out = new ArrayList();
        out.add(item.toString());
        for (int k = 0; k < old.size(); k++) {
            String ln = (String) old.get(k);
            try {
                JSONObject o = new JSONObject(ln);
                if (key.equals(o.optString("key"))) continue;
            } catch (Throwable t2) {
            }
            out.add(ln);
        }
        while (out.size() > 50) out.remove(out.size() - 1);
        store_write(new File(store_dir(), "history.jsonl"), out);
        // 留个脏标记：退回列表页时靠它决定要不要重画（返回不重跑 loading）
        i.sss("qj.hist.dirty", "1");
    } catch (Throwable t) {
        i.syso("STORE save fail " + t);
    }
}

public ArrayList store_history() {
    return store_lines(new File(store_dir(), "history.jsonl"));
}

public void store_clearHistory() {
    File f = new File(store_dir(), "history.jsonl");
    if (f.exists()) f.delete();
}

// 默认值是唯一权威来源：读设置时合并、面板「恢复默认」也照它写
public HashMap store_defaults() {
    HashMap m = new HashMap();
    m.put("font", "18");
    m.put("spacing", "0");
    m.put("lineHeight", "1.75");
    m.put("fontFamily", "sans");
    m.put("theme", "auto");
    m.put("always", "0");
    return m;
}

// 阅读设置：单行 JSON 落盘，读的时候和默认值合并，旧文件缺键也不会崩
public HashMap store_settings() {
    HashMap m = store_defaults();
    try {
        ArrayList one = store_lines(new File(store_dir(), "settings.json"));
        if (one.size() == 0) return m;
        JSONObject o = new JSONObject((String) one.get(0));
        String[] ks = {"font", "spacing", "lineHeight", "fontFamily", "theme", "always"};
        for (int k = 0; k < ks.length; k++) {
            String v = o.optString(ks[k]);
            if (v != null && v.length() > 0) m.put(ks[k], v);
        }
    } catch (Throwable t) {
        i.syso("STORE settings read fail " + t);
    }
    return m;
}

public void store_saveSetting(String key, String val) {
    try {
        if (key == null) return;
        HashMap m = store_settings();
        m.put(key, val == null ? "" : val);
        JSONObject o = new JSONObject();
        String[] ks = {"font", "spacing", "lineHeight", "fontFamily", "theme", "always"};
        for (int k = 0; k < ks.length; k++) o.put(ks[k], "" + m.get(ks[k]));
        ArrayList one = new ArrayList();
        one.add(o.toString());
        store_write(new File(store_dir(), "settings.json"), one);
    } catch (Throwable t) {
        i.syso("STORE settings save fail " + t);
    }
}

public void store_cache(String key, String json) {
    try {
        File d = new File(store_dir(), "cache");
        if (!d.exists()) d.mkdirs();
        ArrayList one = new ArrayList();
        one.add(json);
        store_write(new File(d, key + ".json"), one);
    } catch (Throwable t) {
        i.syso("STORE cache fail " + t);
    }
}

public String store_cacheGet(String key) {
    File f = new File(new File(store_dir(), "cache"), key + ".json");
    if (!f.exists()) return null;
    ArrayList one = store_lines(f);
    if (one.size() == 0) return null;
    return (String) one.get(0);
}


public ArrayList store_recent() {
    return store_lines(new File(store_dir(), "recent.jsonl"));
}

public void store_saveRecent(String kw) {
    if (kw == null) return;
    String k = kw.trim();
    if (k.length() == 0) return;
    try {
        ArrayList old = store_recent();
        ArrayList out = new ArrayList();
        out.add(k);
        for (int i2 = 0; i2 < old.size(); i2++) {
            String ln = (String) old.get(i2);
            if (!k.equals(ln)) out.add(ln);
        }
        while (out.size() > 8) out.remove(out.size() - 1);
        store_write(new File(store_dir(), "recent.jsonl"), out);
    } catch (Throwable t) {
        i.syso("STORE recent fail " + t);
    }
}


public void store_cacheClear(String key) {
    File f = new File(new File(store_dir(), "cache"), key + ".json");
    if (f.exists()) f.delete();
}
